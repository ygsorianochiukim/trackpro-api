APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trackpro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── PayMongo ──────────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Signing secret (whsk_…) from Developers → Webhooks, for the webhook you
# registered at https://<this API's domain>/api/paymongo/webhook — the API's
# domain, not the storefront's. While this is empty, incoming webhooks are
# accepted WITHOUT signature verification.
PAYMONGO_WEBHOOK_SECRET=

# ─── CORS / Frontend ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated regexes for origins that change every build
# (Vercel/Netlify preview deployments). Example:
#   FRONTEND_URL_PATTERNS="#^https://trackpro-[a-z0-9-]+\.vercel\.app$#"
FRONTEND_URL_PATTERNS=

# ─── Admin login (seeded by AdminUserSeeder) ───────────────────────────
# Used to create/update the /admin account on `php artisan db:seed`.
# Change these before seeding a production database.
ADMIN_NAME="TrackPro Admin"
ADMIN_EMAIL=admin@trackprogps.com
ADMIN_PASSWORD=trackpro-change-me

# ─── Yearly subscriptions ───────────────────────────────────────────────
# When a paid order provisions a tracking subscription, is the first year
# bundled with the hardware purchase (true) or invoiced immediately (false)?
# Checkout only ever charges the hardware subtotal, so `true` matches the
# current pricing — flip it if you bill for year one separately.
SUBSCRIPTION_FIRST_YEAR_INCLUDED=true
